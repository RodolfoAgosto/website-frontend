{
  "printWidth": 100,        // ancho máximo de línea
  "tabWidth": 2,            // cantidad de espacios por tab
  "useTabs": false,         // usar tabs en lugar de espacios
  "semi": true,             // punto y coma al final de cada línea
  "singleQuote": true,      // comillas simples en lugar de dobles
  "trailingComma": "es5",   // coma final en objetos/arrays
  "bracketSpacing": true,   // espacio dentro de llaves { a: 1 }
  "arrowParens": "always"   // paréntesis siempre en funciones flecha
}

